<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- checking GitHub for new versions (and Google Drive sync later) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- installing a new version the person chose to download -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 14+: lets LoonieMate's own updates install without a second confirmation, where Android allows it -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- reminders to pay bills and move money, and word of a new version (asked for, Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup is off: Android's own cloud backup would copy the budget unencrypted.
         LoonieMate's encrypted backups are used instead. -->
    <application
        android:name=".LoonieApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoonieMate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
